#!/usr/bin/env python3
"""Entry point; install.sh links it into ~/.local/bin. Finds the package
through its own real path, so it works without the .pth file too."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from stt.cli import main  # noqa: E402

sys.exit(main())
